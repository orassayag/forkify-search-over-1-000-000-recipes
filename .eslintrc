{
  "env": {
    "browser": true,
    "commonjs": true,
    "es6": true,
    "node": true,
  },
  "extends": "eslint:recommended",
  "parser": "babel-eslint",
  "parserOptions": {
    "sourceType": "module",
  },
  "rules": {
    "quotes": [
      "error",
      "single",
      {
        "allowTemplateLiterals": true,
      },
    ],
    "no-shadow": [
      "error",
      {
        "builtinGlobals": false,
        "hoist": "functions",
        "allow": [],
      },
    ],
    "semi": 1,
    "comma-dangle": 1,
    "no-new-wrappers": 0,
    "no-mixed-operators": 0,
    "require-atomic-updates": 0,
    "no-unused-vars": 0,
    "no-useless-constructor": 0,
    "no-useless-escape": 0,
    "no-console": 0,
    "no-debugger": 0,
    "no-empty": 0,
    "disable-next-line": 0,
    "no-case-declarations": 0,
    "default-case": 0,
    "no-async-promise-executor": 0,
    "require-await": 1,
  },
}
